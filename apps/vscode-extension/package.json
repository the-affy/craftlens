{
  "name": "craftlens",
  "displayName": "CraftLens Next",
  "description": "A second pair of eyes for AI-generated software. Find problems, understand why they matter, and improve them.",
  "version": "1.1.1",
  "publisher": "theaffy",
  "license": "MIT",
  "homepage": "https://github.com/the-affy/craftlens",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-affy/craftlens.git"
  },
  "bugs": {
