    "viewsContainers": {
      "activitybar": [
        {
          "id": "craftlens-view",
          "title": "CraftLens",
          "icon": "media/icons/craftlens-sidebar.svg"
        }
      ],
      "panel": [
        {
          "id": "craftlens-panel",
          "title": "CraftLens Details",
          "icon": "media/icons/craftlens-sidebar.svg"
        }
      ]
    },
    "views": {
      "craftlens-view": [
        {
          "id": "craftlens.sidebar",
          "name": "CraftLens",
          "type": "webview"
        }
      ],
      "craftlens-panel": [
        {
          "id": "craftlens.detailPanel",
          "name": "Issue Explanation & Fix",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "craftlens.openProjectOverview",
          "when": "view == craftlens.sidebar",
          "group": "navigation@0"
        },
        {
          "command": "craftlens.runAudit",
          "when": "view == craftlens.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "craftlens.filterSidebar",
          "when": "view == craftlens.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "craftlens.openProblems",
          "when": "view == craftlens.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "craftlens.refreshSidebar",
          "when": "view == craftlens.sidebar",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "craftlens.openFindingLocation",
          "when": "viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "craftlens.explainFinding",
          "when": "viewItem == finding",
          "group": "inline@2"
        },
        {
          "command": "craftlens.applyQuickFix",
          "when": "viewItem == finding-fixable",
          "group": "inline@3"
        },
        {
          "command": "craftlens.markNotAProblem",
          "when": "viewItem == finding || viewItem == finding-fixable",
          "group": "1_modification@1"
        },
        {
          "command": "craftlens.ignoreRule",
          "when": "viewItem == finding || viewItem == finding-fixable",
          "group": "1_modification@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "craftlens.nextIssue",
        "key": "alt+f8",
        "when": "editorTextFocus"
      },
      {
        "command": "craftlens.previousIssue",
        "key": "shift+alt+f8",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "CraftLens",
      "properties": {
        "craftlens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable CraftLens analysis."
        },
        "craftlens.severity": {
          "type": "string",
          "enum": [
            "blocker",
            "error",
            "warning",
            "suggestion",
            "info"
          ],
          "default": "warning",
          "description": "Minimum severity threshold for displayed diagnostics."
        },
        "craftlens.auditLevel": {
          "type": "string",
          "enum": [
            "easy",
            "moderate",
            "hard",
            "strict"
          ],
          "default": "moderate",
          "description": "Audit sensitivity level: easy, moderate (recommended), hard, strict."
        },
        "craftlens.autoAudit": {
          "type": "boolean",
          "default": true,
          "description": "Continuously update Master Audit Checklist as code is changed."
        },
        "craftlens.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Display quiet inline CodeLens hints above findings."
        },
        "craftlens.persistAudit": {
          "type": "boolean",
          "default": true,
          "description": "Persist Master Audit Checklist across sessions."
        },
        "craftlens.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run CraftLens diagnostics whenever a file is saved."
        },
        "craftlens.scanOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Run fast-path CraftLens diagnostics as files are edited (debounced)."
        },
        "craftlens.maxDiagnosticsPerFile": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of diagnostics reported per file."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "node ../../scripts/package-extension.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@craftlens/config": "*",
    "@craftlens/core": "*",
    "@craftlens/design-intelligence": "*",
    "@craftlens/parser": "*",
    "@craftlens/rule-engine": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "icon": "resources/icon.png",
  "keywords": [
    "craftlens",
    "ai-code-review",
    "ui-ux",
    "accessibility",
    "linter",
    "code-quality",
    "design-system"
  ]
}
