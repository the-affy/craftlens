{
  "name": "craftlens-monorepo",
  "version": "1.1.1",
  "private": true,
  "description": "CraftLens Next: High-precision, context-aware quality linter for modern software",
  "license": "MIT",
  "homepage": "https://github.com/the-affy/craftlens",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-affy/craftlens.git"
  },
  "bugs": {
    "url": "https://github.com/the-affy/craftlens/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "compile": "npm run --workspaces build",
    "package": "node scripts/package-extension.js",
    "clean": "npm run --workspaces clean && rm -rf dist *.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
