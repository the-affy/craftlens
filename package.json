{
  "name": "anti-slop-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Anti-Slop: High-precision, context-aware quality linter for modern software",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "compile": "npm run --workspaces build"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
