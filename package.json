{
  "name": "craftlens-monorepo",
  "version": "0.1.16",
  "private": true,
  "description": "CraftLens: High-precision, context-aware quality linter for modern software",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "compile": "npm run --workspaces build",
    "package": "node scripts/package-extension.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
